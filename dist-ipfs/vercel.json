{
  "cleanUrls": true,
  "outputDirectory": "dist-ipfs",
  "routes": [
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/gallery", "dest": "/gallery/index.html" },
    { "src": "/photo-gallery", "dest": "/photo-gallery/index.html" },
    { "src": "/video-gallery", "dest": "/video-gallery/index.html" },
    { "src": "/api/(.*)", "dest": "https://anon-studios-site.onrender.com/api/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/home-animations.js", "dest": "/home-animations.js" },
    { "src": "/home-interactions.js", "dest": "/home-interactions.js" },
    { "src": "/site-content.js", "dest": "/site-content.js" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/((?!admin|gallery|photo-gallery|video-gallery|api|assets|home-animations.js|home-interactions.js|site-content.js|favicon.ico|index.html).*)", "dest": "/delivery/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/gallery",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/photo-gallery",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/video-gallery",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!assets|gallery|photo-gallery|video-gallery|admin|data|scratch|dist-ipfs|favicon.ico|index.html|home-animations.js|home-interactions.js|site-content.js)[^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
