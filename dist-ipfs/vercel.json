{
  "cleanUrls": true,
  "outputDirectory": "dist-ipfs",
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/photo-gallery", "destination": "/photo-gallery/index.html" },
    { "source": "/video-gallery", "destination": "/video-gallery/index.html" },
    { "source": "/api/(.*)", "destination": "https://anon-studios-site.onrender.com/api/$1" },
    { "source": "/:name", "destination": "/delivery/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/gallery",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/photo-gallery",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/video-gallery",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!assets|gallery|photo-gallery|video-gallery|admin|data|scratch|dist-ipfs|favicon.ico|index.html|home-animations.js|home-interactions.js|site-content.js)[^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
